# Supabase -> Project Settings -> Data API / API Keys
# Both are safe to expose to the browser: the anon key is protected by the RLS
# policies in supabase/schema.sql. Never put the service_role key in here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI extraction pipeline (scripts/extract) -------------------------------
# Used ONLY by `npm run extract`, which runs on your machine. Never imported by
# anything under src/, and never given a NEXT_PUBLIC_ prefix — the service-role
# key bypasses every RLS policy in the schema.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Preferred for volume: the free tier is request-bound with a generous token
# allowance, and 1M context removes the passage-budget squeeze entirely.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default gemini-2.0-flash. `npm run extract -- --models` lists yours.
GEMINI_MODEL=gemini-2.0-flash
# Optional. Free-tier requests per minute for your model.
GEMINI_RPM=15

GROQ_API_KEY=gsk_...
# Optional. Default llama-3.3-70b-versatile. `npm run extract -- --models` lists
# what your key can reach; openai/gpt-oss-* models accept json_schema natively,
# which saves ~800 tokens per call versus the json_object fallback.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional. Tokens per minute for your tier and model — Groq console → Limits.
# The pipeline sizes every request to 85% of this, so getting it right matters
# more than it looks: too high and you get 429s, too low and you waste context.
GROQ_TPM=12000
